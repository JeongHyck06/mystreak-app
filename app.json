{
  "expo": {
    "name": "My Streak",
    "slug": "mystreak",
    "scheme": "mystreak",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "인증 사진을 촬영하기 위해 카메라 권한이 필요합니다.",
        "NSPhotoLibraryUsageDescription": "인증 사진과 동영상을 선택하기 위해 사진 보관함 권한이 필요합니다.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.wjdgur050700.mystreak",
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f5faf5"
      },
      "package": "com.wjdgur050700.mystreak",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-web-browser",
      "expo-image-picker",
      "expo-apple-authentication",
      "expo-notifications",
      "expo-video",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-1582609839942668~8764226072",
          "iosAppId": "ca-app-pub-1582609839942668~4681098140",
          "userTrackingUsageDescription": "맞춤형 광고 제공을 위해 앱 사용 데이터를 사용할 수 있습니다."
        }
      ],
      "react-native-iap"
    ],
    "extra": {
      "eas": {
        "projectId": "a7be7bfe-8ed8-4695-9285-ee36c274f2a3"
      }
    }
  }
}
